# ---- Backend environment variables (Render / Railway) ----
DB_URL=jdbc:mysql://HOST:PORT/bloodconnect?useSSL=true&serverTimezone=UTC
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
# generate with: openssl rand -base64 48
JWT_SECRET=PASTE_BASE64_SECRET_HERE
# frontend URL, no trailing slash (comma-separate for several)
BLOODCONNECT_CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
ADMIN_EMAIL=admin@bloodconnect.com
ADMIN_PASSWORD=change_me_strong
SEED_DEMO=true
# Quick demo without MySQL (data resets on restart):
# SPRING_PROFILES_ACTIVE=h2

# ---- Frontend (Vercel / Netlify) build variable ----
# VITE_API_URL=https://YOUR-BACKEND-URL/api
